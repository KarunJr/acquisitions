{
  "compilerOptions": {
    "rootDir": "./src",
    "outDir": "./dist",

    "module": "nodenext",
    "moduleResolution": "nodenext",
    "target": "es2022",
    "types": ["node"],

    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,
    "strict": true,
    "skipLibCheck": true,
    "paths": {
      "#config/*": ["./src/config/*"],
      "#controllers/*": ["./src/controllers/*"],
      "#middleware/*": ["./src/middleware/*"],
      "#models/*": ["./src/models/*"],
      "#routes/*": ["./src/routes/*"],
      "#services/*": ["./src/services/*"],
      "#utils/*": ["./src/utils/*"],
      "#validations/*": ["./src/validations/*"]
    }
  },
  "include": ["./src/**/*.ts", "drizzle.config.js"],
  "exclude": ["node_modules"]
}
