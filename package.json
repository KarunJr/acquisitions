    "#models/*": "./src/models",
    "#routes/*": "./src/routes",
    "#services/*": "./src/services",
    "#utils/*": "./src/utils",
    "#validations/*": "./src/validations"
  },
  "scripts": {
    "dev": "tsx watch ./src/index.ts",
    "build": "tsc",
